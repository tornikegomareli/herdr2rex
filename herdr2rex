#!/usr/bin/env python3
"""Import herdr workspaces into Rex, or with --reverse, Rex sessions into herdr.

herdr workspace -> Rex session, herdr tab -> Rex window, herdr pane -> Rex block.
Panes that held an agent session resume it in their shell, the same way herdr does.
Run it again to add the panes and tabs that are missing in Rex.
--reverse writes herdr's session.json while herdr is stopped. herdr restores it on start.
"""
import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys

HERDR_SESSION = os.path.expanduser("~/.config/herdr/session.json")
REX_DEFAULT = os.path.expanduser(
    "~/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
)
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "herdr2rex", "state.json")
CLAUDE_SESSIONS = os.path.join(os.environ.get("CLAUDE_CONFIG_DIR") or os.path.expanduser("~/.claude"), "sessions")
PUBLIC_ID_ALPHABET = "123456789ABCDEFGHJKMNPQRSTVWXYZ0"  # herdr's src/workspace.rs
DIRECTIONS = {"Horizontal": "right", "Vertical": "below"}
OPPOSITE = {"right": "left", "below": "above"}
# Copied from herdr's src/agent_resume.rs. Keys are the saved agent_session source.
RESUME = {
    "herdr:claude": "claude --resume {}",
    "herdr:codex": "codex resume {}",
    "herdr:copilot": "copilot --resume={}",
    "herdr:devin": "devin --resume {}",
    "herdr:droid": "droid --resume {}",
    "herdr:kimi": "kimi --session {}",
    "herdr:mastracode": "mastracode --thread {}",
    "herdr:pi": "pi --session {}",
    "herdr:omp": "omp --resume={}",
    "herdr:hermes": "hermes --resume {}",
    "herdr:opencode": "opencode --session {}",
    "herdr:qodercli": "qodercli --resume {}",
    "herdr:qwen": "qwen --resume {}",
    "herdr:kilo": "kilo --session {}",
    "herdr:cursor": "cursor-agent --resume {}",
    "herdr:antigravity_cli": "agy --conversation {}",
    "herdr:grok": "grok --resume {}",
}


def first_pane(node):
    return node["Pane"] if "Pane" in node else first_pane(node["Split"]["first"])


def workspace_label(ws):
    return ws.get("custom_name") or os.path.basename(ws["identity_cwd"])


def decode_public_number(text):
    value = 0
    for ch in text:
        value = value * len(PUBLIC_ID_ALPHABET) + PUBLIC_ID_ALPHABET.index(ch) + 1
    return value


def encode_public_number(value):
    text = ""
    while value > 0:
        value, digit = divmod(value - 1, len(PUBLIC_ID_ALPHABET))
        text = PUBLIC_ID_ALPHABET[digit] + text
    return text


def herdr_running():
    try:
        return subprocess.run(["herdr", "workspace", "list"], capture_output=True).returncode == 0
    except OSError:
        return False


def herdr_titles():
    """Map agent session value -> pane title from the running herdr. Empty if herdr is not running."""
    try:
        out = subprocess.run(["herdr", "pane", "list"], check=True, capture_output=True, text=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return {}
    return {p["agent_session"]["value"]: p["terminal_title_stripped"]
            for p in json.loads(out)["result"]["panes"]
            if p.get("agent_session") and p.get("terminal_title_stripped")}


class Importer:
    def __init__(self, rex, dry_run):
        self.rex = rex
        self.dry_run = dry_run
        self.fake_ids = 0
        self.titles = herdr_titles()

    def query(self, *args):
        out = subprocess.run([self.rex, *args, "--json"], check=True, capture_output=True, text=True).stdout
        return json.loads(out)

    def call(self, *args):
        if self.dry_run:
            print("rex " + shlex.join(args).replace("\n", "\\n"))
            if "--json" not in args:
                return None
            self.fake_ids += 1
            block = f"block{self.fake_ids}"
            return {"session_id": "SESSION", "block_ids": [block], "initial_windows": [{"block_ids": [block]}]}
        out = subprocess.run([self.rex, *args], check=True, capture_output=True, text=True).stdout
        return json.loads(out) if "--json" in args else None

    def existing_labels(self):
        return {s["label"] for s in self.query("ls")["sessions"]}

    def live_blocks(self, session):
        """Block IDs in a Rex session, or None if the session is gone."""
        try:
            info = self.query("session", "inspect", session)
        except subprocess.CalledProcessError:
            return None
        return {b["block_id"] for w in info["windows"] for layer in w["layers"] for b in layer["blocks"]}

    def sync_workspace(self, ws, entry, live):
        """Create every pane of ws that has no live block in Rex. Returns how many were created."""
        self.entry = entry
        self.panes = {k: v for tab in ws["tabs"] for k, v in tab["panes"].items()}
        # herdr gives panes new internal IDs on every restart, but keeps their public numbers.
        numbers = ws.get("public_pane_numbers", {})
        self.key = lambda pane: str(numbers.get(str(pane), pane))
        self.added = 0
        for tab in ws["tabs"]:
            if self.sync(tab["layout"], live) is None:
                self.new_window(ws, tab)
        keep = {self.key(pane) for pane in self.panes}
        entry["blocks"] = {k: v for k, v in entry["blocks"].items() if k in keep}
        return self.added

    def new_window(self, ws, tab):
        cwd = self.panes[str(first_pane(tab["layout"]))]["cwd"]
        name = [tab["custom_name"]] if tab.get("custom_name") else []
        if self.entry["session"] is None:
            window = ["--window", *name] if name else []
            res = self.call("new", workspace_label(ws), *window, "-c", cwd, "--json")
            self.entry["session"] = res["session_id"]
            block = res["initial_windows"][0]["block_ids"][0]
        else:
            res = self.call("window", "new", "-s", self.entry["session"], *name, "-c", cwd, "--focus=false", "--json")
            block = res["block_ids"][0]
        self.build(tab["layout"], block)

    def sync(self, node, live):
        """Add the missing parts of node next to its live blocks. Returns a live block in node, or None."""
        if "Pane" in node:
            block = self.entry["blocks"].get(self.key(node["Pane"]))
            return block if block in live else None
        split = node["Split"]
        first = self.sync(split["first"], live)
        second = self.sync(split["second"], live)
        direction = DIRECTIONS[split["direction"]]
        if first and not second:
            self.add(split["second"], first, direction, 1 - split["ratio"])
        elif second and not first:
            self.add(split["first"], second, OPPOSITE[direction], split["ratio"])
        return first or second

    def build(self, node, block):
        """Create the whole layout of node. block already hosts its first pane."""
        if "Pane" in node:
            self.start(str(node["Pane"]), block)
            return
        split = node["Split"]
        self.add(split["second"], block, DIRECTIONS[split["direction"]], 1 - split["ratio"])
        self.build(split["first"], block)

    def add(self, node, anchor, direction, share):
        cwd = self.panes[str(first_pane(node))]["cwd"]
        res = self.call(
            "split", "-s", self.entry["session"], "-b", anchor, "--split", direction,
            "--ratio", str(round(share * 100)), "-c", cwd, "--focus=false", "--json",
        )
        self.build(node, res["block_ids"][0])

    def start(self, pane, block):
        self.entry["blocks"][self.key(pane)] = block
        self.added += 1
        session = self.entry["session"]
        agent = self.panes[pane].get("agent_session") or {}
        title = self.titles.get(agent.get("value"))
        if title:
            self.call("block", "rename", "-s", session, "--", block, title)
        command = RESUME.get(agent.get("source"))
        if command:
            self.call("send", "-s", session, "-b", block, command.format(shlex.quote(agent["value"])) + "\n")


class Exporter:
    """Builds herdr workspaces from live Rex sessions."""

    def __init__(self, rex):
        self.rex = rex

    def run(self, *args):
        return json.loads(subprocess.run([self.rex, *args], check=True, capture_output=True, text=True).stdout)

    def workspace(self, session, entry):
        """Build a herdr workspace from a Rex session. Updates entry to map its public pane numbers to blocks."""
        info = self.run("session", "inspect", session, "--json")
        # Keep the public numbers of panes that came from herdr, so a later import sees them as up to date.
        numbers = {block: int(n) for n, block in entry["blocks"].items()}
        public, blocks, tabs = {}, {}, []

        def layout(node, panes):
            if "block_id" in node:
                block = node["block_id"]
                numbers.setdefault(block, max(numbers.values(), default=0) + 1)
                pane = len(public) + 1
                public[str(pane)] = numbers[block]
                blocks[str(numbers[block])] = block
                panes[str(pane)] = self.pane(session, block)
                return {"Pane": pane}
            split = node["split"]
            return {"Split": {"direction": split["direction"].capitalize(), "ratio": split["ratio"],
                              "first": layout(split["before"], panes), "second": layout(split["after"], panes)}}

        for window in info["windows"]:
            tiled = next(layer for layer in window["layers"] if layer["kind"] == "tiled")
            panes = {}
            tree = layout(tiled["layout"], panes)
            label = window["label"]
            tabs.append({
                "custom_name": None if label == "Window " + window["window_id"][-8:] else label,
                "layout": tree, "panes": panes, "zoomed": False, "root_pane": first_pane(tree),
            })
        entry["blocks"] = blocks
        windows = [w["window_id"] for w in info["windows"]]
        return {
            "custom_name": info["label"],
            "identity_cwd": tabs[0]["panes"][str(tabs[0]["root_pane"])]["cwd"],
            "public_pane_numbers": public,
            "next_public_pane_number": max(public.values()) + 1,
            "tabs": tabs,
            "active_tab": windows.index(info["active_window_id"]) if info.get("active_window_id") in windows else 0,
        }

    def pane(self, session, block):
        process = self.run("block", "call", "-s", session, "-b", block, "process")
        foreground = process.get("foreground") or {}
        pane = {"cwd": foreground.get("cwd") or process["home"]}
        # Claude Code writes the session of each running process to <pid>.json.
        claude = os.path.join(CLAUDE_SESSIONS, f"{foreground.get('pid')}.json")
        if os.path.exists(claude):
            with open(claude) as f:
                value = json.load(f)["sessionId"]
            pane["agent_session"] = {"source": "herdr:claude", "agent": "claude", "kind": "id", "value": value}
        return pane


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f, indent=2)


def to_herdr(args, rex):
    if not args.dry_run and herdr_running():
        sys.exit("herdr is running. Stop it with `herdr server stop` first, or it overwrites session.json.")
    try:
        with open(args.herdr_file) as f:
            herdr = json.load(f)
    except FileNotFoundError:
        herdr = {"version": 3, "workspaces": [], "active": None, "selected": 0}
    exporter = Exporter(rex)
    state = load_state()
    workspaces = herdr["workspaces"]
    workspace_of = {entry["session"]: wid for wid, entry in state.items()}
    by_id = {ws["id"]: i for i, ws in enumerate(workspaces) if ws.get("id")}
    by_label = {workspace_label(ws): i for i, ws in enumerate(workspaces)}
    next_id = max((decode_public_number(ws["id"][1:]) for ws in workspaces if ws.get("id")), default=0) + 1
    exported = []

    for session in exporter.run("ls", "--json")["sessions"]:
        label, sid = session["label"], session["session_id"]
        if args.workspaces and label not in args.workspaces:
            continue
        index = by_id.get(workspace_of.get(sid), by_label.get(label))
        wid = workspaces[index].get("id") if index is not None else None
        if not wid:
            wid, next_id = "w" + encode_public_number(next_id), next_id + 1
        old = state.get(wid)
        entry = old if old and old["session"] == sid else {"session": sid, "blocks": {}}
        ws = dict(exporter.workspace(sid, entry), id=wid)
        if index is None:
            workspaces.append(ws)
        else:
            workspaces[index] = ws
        state[wid] = entry
        exported.append(label)
        if args.dry_run:
            print(f"would {'export' if index is None else 'replace'} {label}")
        else:
            print(f"{'exported' if index is None else 'replaced'} {label}")

    if args.dry_run or not exported:
        return
    if os.path.exists(args.herdr_file):
        shutil.copyfile(args.herdr_file, args.herdr_file + ".bak")
    with open(args.herdr_file, "w") as f:
        json.dump(herdr, f, indent=2)
    save_state(state)
    print("Close these sessions in Rex before you start herdr, or each agent runs in both:")
    print("  rex kill " + " ".join(shlex.quote(label) for label in exported))


def to_rex(args, rex):
    with open(args.herdr_file) as f:
        herdr = json.load(f)
    importer = Importer(rex, args.dry_run)
    existing = importer.existing_labels()
    state = load_state()

    for ws in herdr["workspaces"]:
        label = workspace_label(ws)
        if args.workspaces and label not in args.workspaces:
            continue
        entry = state.get(ws["id"])
        live = importer.live_blocks(entry["session"]) if entry else None
        if live is None:
            if label in existing:
                print(f"skip {label}: Rex already has a session with this name")
                continue
            entry, live = {"session": None, "blocks": {}}, set()
        new = entry["session"] is None
        try:
            added = importer.sync_workspace(ws, entry, live)
        except subprocess.CalledProcessError as e:
            sys.exit(f"failed on {label}: {e.stderr.strip()}")
        finally:
            if entry["session"] and not args.dry_run:
                state[ws["id"]] = entry
                save_state(state)
        existing.add(label)
        if new:
            print(f"{'would import' if args.dry_run else 'imported'} {label}")
        elif added:
            print(f"{'would add' if args.dry_run else 'added'} {added} pane{'' if added == 1 else 's'} to {label}")
        else:
            print(f"{label} is up to date")


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("workspaces", nargs="*",
                        help="herdr workspaces to import, or Rex sessions with --reverse (default: all)")
    parser.add_argument("--reverse", action="store_true", help="copy Rex sessions into herdr instead")
    parser.add_argument("--herdr-file", default=HERDR_SESSION, help="herdr's session.json")
    parser.add_argument("--dry-run", action="store_true", help="print what would change instead of changing it")
    args = parser.parse_args()
    rex = shutil.which("rex") or REX_DEFAULT
    to_herdr(args, rex) if args.reverse else to_rex(args, rex)


if __name__ == "__main__":
    main()
