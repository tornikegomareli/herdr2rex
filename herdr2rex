#!/usr/bin/env python3
"""Import herdr workspaces into Rex.

herdr workspace -> Rex session, herdr tab -> Rex window, herdr pane -> Rex block.
Panes that held an agent session resume it in their shell, the same way herdr does.
Run it again to add the panes and tabs that are missing in Rex.
"""
import argparse
import json
import os
import shlex
import shutil
import subprocess
import sys

HERDR_SESSION = os.path.expanduser("~/.config/herdr/session.json")
REX_DEFAULT = os.path.expanduser(
    "~/Library/Application Support/com.superlogical.rex/RexServer/Versions/Current/Rex Server.app/Contents/MacOS/rex"
)
STATE = os.path.join(os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state"), "herdr2rex", "state.json")
DIRECTIONS = {"Horizontal": "right", "Vertical": "below"}
OPPOSITE = {"right": "left", "below": "above"}
# Copied from herdr's src/agent_resume.rs. Keys are the saved agent_session source.
RESUME = {
    "herdr:claude": "claude --resume {}",
    "herdr:codex": "codex resume {}",
    "herdr:copilot": "copilot --resume={}",
    "herdr:devin": "devin --resume {}",
    "herdr:droid": "droid --resume {}",
    "herdr:kimi": "kimi --session {}",
    "herdr:mastracode": "mastracode --thread {}",
    "herdr:pi": "pi --session {}",
    "herdr:omp": "omp --resume={}",
    "herdr:hermes": "hermes --resume {}",
    "herdr:opencode": "opencode --session {}",
    "herdr:qodercli": "qodercli --resume {}",
    "herdr:qwen": "qwen --resume {}",
    "herdr:kilo": "kilo --session {}",
    "herdr:cursor": "cursor-agent --resume {}",
    "herdr:antigravity_cli": "agy --conversation {}",
    "herdr:grok": "grok --resume {}",
}


def first_pane(node):
    return node["Pane"] if "Pane" in node else first_pane(node["Split"]["first"])


def workspace_label(ws):
    return ws.get("custom_name") or os.path.basename(ws["identity_cwd"])


def herdr_titles():
    """Map agent session value -> pane title from the running herdr. Empty if herdr is not running."""
    try:
        out = subprocess.run(["herdr", "pane", "list"], check=True, capture_output=True, text=True).stdout
    except (OSError, subprocess.CalledProcessError):
        return {}
    return {p["agent_session"]["value"]: p["terminal_title_stripped"]
            for p in json.loads(out)["result"]["panes"]
            if p.get("agent_session") and p.get("terminal_title_stripped")}


class Importer:
    def __init__(self, rex, dry_run):
        self.rex = rex
        self.dry_run = dry_run
        self.fake_ids = 0
        self.titles = herdr_titles()

    def query(self, *args):
        out = subprocess.run([self.rex, *args, "--json"], check=True, capture_output=True, text=True).stdout
        return json.loads(out)

    def call(self, *args):
        if self.dry_run:
            print("rex " + shlex.join(args).replace("\n", "\\n"))
            if "--json" not in args:
                return None
            self.fake_ids += 1
            block = f"block{self.fake_ids}"
            return {"session_id": "SESSION", "block_ids": [block], "initial_windows": [{"block_ids": [block]}]}
        out = subprocess.run([self.rex, *args], check=True, capture_output=True, text=True).stdout
        return json.loads(out) if "--json" in args else None

    def existing_labels(self):
        return {s["label"] for s in self.query("ls")["sessions"]}

    def live_blocks(self, session):
        """Block IDs in a Rex session, or None if the session is gone."""
        try:
            info = self.query("session", "inspect", session)
        except subprocess.CalledProcessError:
            return None
        return {b["block_id"] for w in info["windows"] for layer in w["layers"] for b in layer["blocks"]}

    def sync_workspace(self, ws, entry, live):
        """Create every pane of ws that has no live block in Rex. Returns how many were created."""
        self.entry = entry
        self.panes = {k: v for tab in ws["tabs"] for k, v in tab["panes"].items()}
        self.added = 0
        for tab in ws["tabs"]:
            if self.sync(tab["layout"], live) is None:
                self.new_window(ws, tab)
        entry["blocks"] = {k: v for k, v in entry["blocks"].items() if k in self.panes}
        return self.added

    def new_window(self, ws, tab):
        cwd = self.panes[str(first_pane(tab["layout"]))]["cwd"]
        name = [tab["custom_name"]] if tab.get("custom_name") else []
        if self.entry["session"] is None:
            window = ["--window", *name] if name else []
            res = self.call("new", workspace_label(ws), *window, "-c", cwd, "--json")
            self.entry["session"] = res["session_id"]
            block = res["initial_windows"][0]["block_ids"][0]
        else:
            res = self.call("window", "new", "-s", self.entry["session"], *name, "-c", cwd, "--focus=false", "--json")
            block = res["block_ids"][0]
        self.build(tab["layout"], block)

    def sync(self, node, live):
        """Add the missing parts of node next to its live blocks. Returns a live block in node, or None."""
        if "Pane" in node:
            block = self.entry["blocks"].get(str(node["Pane"]))
            return block if block in live else None
        split = node["Split"]
        first = self.sync(split["first"], live)
        second = self.sync(split["second"], live)
        direction = DIRECTIONS[split["direction"]]
        if first and not second:
            self.add(split["second"], first, direction, 1 - split["ratio"])
        elif second and not first:
            self.add(split["first"], second, OPPOSITE[direction], split["ratio"])
        return first or second

    def build(self, node, block):
        """Create the whole layout of node. block already hosts its first pane."""
        if "Pane" in node:
            self.start(str(node["Pane"]), block)
            return
        split = node["Split"]
        self.add(split["second"], block, DIRECTIONS[split["direction"]], 1 - split["ratio"])
        self.build(split["first"], block)

    def add(self, node, anchor, direction, share):
        cwd = self.panes[str(first_pane(node))]["cwd"]
        res = self.call(
            "split", "-s", self.entry["session"], "-b", anchor, "--split", direction,
            "--ratio", str(round(share * 100)), "-c", cwd, "--focus=false", "--json",
        )
        self.build(node, res["block_ids"][0])

    def start(self, pane, block):
        self.entry["blocks"][pane] = block
        self.added += 1
        session = self.entry["session"]
        agent = self.panes[pane].get("agent_session") or {}
        title = self.titles.get(agent.get("value"))
        if title:
            self.call("block", "rename", "-s", session, "--", block, title)
        command = RESUME.get(agent.get("source"))
        if command:
            self.call("send", "-s", session, "-b", block, command.format(shlex.quote(agent["value"])) + "\n")


def load_state():
    try:
        with open(STATE) as f:
            return json.load(f)
    except FileNotFoundError:
        return {}


def save_state(state):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        json.dump(state, f, indent=2)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("workspaces", nargs="*", help="labels of workspaces to import (default: all)")
    parser.add_argument("--from", dest="source", default=HERDR_SESSION, help="herdr session.json to read")
    parser.add_argument("--dry-run", action="store_true", help="print rex commands instead of running them")
    args = parser.parse_args()

    with open(args.source) as f:
        herdr = json.load(f)
    importer = Importer(shutil.which("rex") or REX_DEFAULT, args.dry_run)
    existing = importer.existing_labels()
    state = load_state()

    for ws in herdr["workspaces"]:
        label = workspace_label(ws)
        if args.workspaces and label not in args.workspaces:
            continue
        entry = state.get(ws["id"])
        live = importer.live_blocks(entry["session"]) if entry else None
        if live is None:
            if label in existing:
                print(f"skip {label}: Rex already has a session with this name")
                continue
            entry, live = {"session": None, "blocks": {}}, set()
        new = entry["session"] is None
        try:
            added = importer.sync_workspace(ws, entry, live)
        except subprocess.CalledProcessError as e:
            sys.exit(f"failed on {label}: {e.stderr.strip()}")
        finally:
            if entry["session"] and not args.dry_run:
                state[ws["id"]] = entry
                save_state(state)
        existing.add(label)
        if new:
            print(f"{'would import' if args.dry_run else 'imported'} {label}")
        elif added:
            print(f"{'would add' if args.dry_run else 'added'} {added} pane{'' if added == 1 else 's'} to {label}")
        else:
            print(f"{label} is up to date")


if __name__ == "__main__":
    main()
